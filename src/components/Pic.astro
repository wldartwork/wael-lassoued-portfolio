---
/*
  Affiche une image qu'elle soit locale (optimisée par Astro : webp, srcset)
  ou distante (URL, affichée telle quelle).
*/
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  class?: string;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  widths?: number[];
}

const {
  src,
  alt,
  class: className,
  sizes = '(max-width: 767px) 100vw, 50vw',
  loading = 'lazy',
  widths = [480, 800, 1200, 1600],
} = Astro.props;
---

{
  typeof src === 'string' ? (
    <img src={src} alt={alt} class={className} loading={loading} decoding="async" />
  ) : (
    <Image
      src={src}
      alt={alt}
      class={className}
      widths={widths}
      sizes={sizes}
      format="webp"
      loading={loading}
      decoding="async"
    />
  )
}
