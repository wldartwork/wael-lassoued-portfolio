---
import Base from '../layouts/Base.astro';
import { site } from '../site';
---

<Base title="About" description={site.description}>
  <section class="about-wrap" id="top">
    <div class="wl-title">
      <h1>{site.name}</h1>
      <span class="wl-service">Art direction</span>
    </div>
    <div class="about-text">
      <p>
        Directeur artistique basé à Paris, spécialisé dans le luxe et le lifestyle : contenu de marque et
        communication visuelle. Fondateur de WLD Artwork depuis 2026.
      </p>
      <p>
        Identité visuelle, packaging, édito, campagnes, social media. Suite Adobe (Photoshop, Illustrator,
        InDesign, Premiere Pro) et création d'image assistée par IA, pratiquée au quotidien et dirigée comme
        un shooting. Gestion de projet de A à Z, coordination d'équipes créatives et de prestataires, suivi de
        fabrication, relation client.
      </p>
      <p>Disponible pour un poste de DA ou de bras droit de DA, en studio ou en agence.</p>
      <ul class="about-list">
        <li><span class="muted">Mail:</span><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li>
          <span class="muted">Instagram:</span>
          <a href={site.instagram} target="_blank" rel="noopener">@wldartwork</a>
        </li>
        <li><span class="muted">Studio:</span><span>{site.location}</span></li>
      </ul>
    </div>
  </section>
</Base>
