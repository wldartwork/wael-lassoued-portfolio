---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import { getWorks, year } from '../lib/work';

const works = await getWorks();
---

<Base>
  <h1 class="sr-only">Work</h1>
  <ul class="work-grid" id="top">
    {
      works.map((w, i) => (
        <li>
          <a class="work-card" href={`/work/${w.id}/`}>
            <Pic
              src={w.data.cover}
              alt={w.data.title}
              class="work-cover"
              loading={i < 2 ? 'eager' : 'lazy'}
              sizes="(max-width: 767px) 100vw, 50vw"
            />
            <div class="work-meta">
              <span class="work-title">{w.data.title}</span>
              <span class="work-service">{w.data.service}</span>
              <span class="work-year">{year(w.data.date)}</span>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
