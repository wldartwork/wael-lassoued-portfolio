---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Pic from '../../components/Pic.astro';
import { getWorks, monthYear } from '../../lib/work';

export async function getStaticPaths() {
  const works = await getWorks();
  return works.map((work, i) => ({
    params: { slug: work.id },
    props: { work, next: works[(i + 1) % works.length] },
  }));
}

const { work, next } = Astro.props;
const { Content } = await render(work);
const pad = (n: number) => String(n).padStart(2, '0');

/* 1. images : couverture + images du projet (sans doublon) */
const images = [work.data.cover, ...work.data.images].filter(
  (img, i, arr) => arr.findIndex((o) => (typeof o === 'string' ? o : o.src) === (typeof img === 'string' ? img : img.src)) === i
);
const ogImage = typeof work.data.cover === 'string' ? work.data.cover : new URL(work.data.cover.src, Astro.site).href;
const isVideo = (m: unknown): m is string => typeof m === 'string' && /\.(mp4|webm)$/.test(m);
const poster = (v: string) => v.replace(/\.(mp4|webm)$/, '.jpg');
---

<Base title={work.data.title} description={`${work.data.title} · ${work.data.service}`} image={ogImage}>
  <section class="wl-section" id="top">
    <div class="wl-wrap">
      <div class="wl-images">
        {
          images.map((img, i) => (
            <figure class="wl-fig" id={`img-${i + 1}`}>
              <span class="wl-num">{pad(i + 1)}</span>
              {isVideo(img) ? (
                <video class="wl-video" src={img} poster={poster(img)} autoplay muted loop playsinline preload="metadata" />
              ) : (
                <Pic
                  src={img}
                  alt={`${work.data.title} ${pad(i + 1)}`}
                  loading={i < 2 ? 'eager' : 'lazy'}
                  sizes="(max-width: 767px) 100vw, 50vw"
                />
              )}
            </figure>
          ))
        }
      </div>

      <aside class="wl-info">
        <a class="wl-close" href="/" aria-label="Retour à l'accueil">[ X ]</a>

        {
          images.length > 1 && (
            <ul class="wl-thumbs" aria-label="Aller à l'image">
              {images.map((img, i) => (
                <li>
                  <a class="wl-thumb" href={`#img-${i + 1}`} data-index={i}>
                    {isVideo(img) ? <img src={poster(img)} alt="" loading="lazy" /> : <Pic src={img} alt="" widths={[112, 168]} sizes="56px" />}
                  </a>
                </li>
              ))}
            </ul>
          )
        }

        <div class="wl-title">
          <h1>{work.data.title}</h1>
          <span class="wl-service">{work.data.service}</span>
        </div>

        <div class="wl-summary">
          <Content />
        </div>

        <dl class="wl-details">
          {
            work.data.client && (
              <div class="wl-detail">
                <dt>Client:</dt>
                <dd>{work.data.client}</dd>
              </div>
            )
          }
          <div class="wl-detail">
            <dt>Date:</dt>
            <dd>{monthYear(work.data.date)}</dd>
          </div>
        </dl>

        {
          next && next.id !== work.id && (
            <a class="wl-next" href={`/work/${next.id}/`}>
              Next work → <span class="muted">{next.data.title}</span>
            </a>
          )
        }
      </aside>
    </div>
  </section>
</Base>

<script>
  /* vignette active au scroll */
  const figs = Array.from(document.querySelectorAll<HTMLElement>('.wl-fig'));
  const thumbs = Array.from(document.querySelectorAll<HTMLElement>('.wl-thumb'));
  if ('IntersectionObserver' in window && thumbs.length > 1) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((en) => {
          if (!en.isIntersecting) return;
          const i = figs.indexOf(en.target as HTMLElement);
          thumbs.forEach((t, j) => t.classList.toggle('is-active', j === i));
        });
      },
      { rootMargin: '-40% 0px -50% 0px', threshold: 0 }
    );
    figs.forEach((f) => io.observe(f));
  }

  /* vidéos : lecture quand visibles, pause sinon (muettes, en boucle) */
  const videos = Array.from(document.querySelectorAll<HTMLVideoElement>('.wl-video'));
  if ('IntersectionObserver' in window && videos.length) {
    const vio = new IntersectionObserver(
      (entries) => {
        entries.forEach((en) => {
          const v = en.target as HTMLVideoElement;
          if (en.isIntersecting) v.play().catch(() => {});
          else v.pause();
        });
      },
      { rootMargin: '200px 0px', threshold: 0 }
    );
    videos.forEach((v) => vio.observe(v));
  }
</script>
